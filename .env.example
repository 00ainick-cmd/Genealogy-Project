# Database
DATABASE_URL="postgresql://user:password@localhost:5432/storytree?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# AI Service for Narrative Generation
# StoryTree uses Claude (Anthropic) for generating Ken Burns-style documentary narratives
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Alternative: OpenAI (for future use - currently narrative engine uses Anthropic only)
# OPENAI_API_KEY="your-openai-api-key"

# File Upload
MAX_FILE_SIZE_MB=20
UPLOAD_DIR="./uploads"

# Feature Flags
# Set to 'true' to enable AI narrative generation
# Requires ANTHROPIC_API_KEY to be configured
ENABLE_AI_GENERATION=true
